+                // Pipelined data can remain ahead of EOF while a blocking command prevents the next receive.
+                if (socket.LocalEndPoint is IPEndPoint local && socket.RemoteEndPoint is IPEndPoint remote)
+                {
+                    foreach (var connection in IPGlobalProperties.GetIPGlobalProperties().GetActiveTcpConnections())
+                    {
+                        if (connection.LocalEndPoint.Equals(local) && connection.RemoteEndPoint.Equals(remote))
+                            return connection.State == TcpState.Established;
+                    }
+                }
+                return true;
+            }
+            catch (Exception ex) when (ex is SocketException or ObjectDisposedException)
+            {
+                return false;
+            }
+            catch (Exception ex) when (ex is NetworkInformationException or PlatformNotSupportedException)
+            {
+                // An unavailable TCP snapshot does not establish that a live peer disconnected.
+                return true;
+            }
+        }
